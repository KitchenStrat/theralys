# ──────────────────────────────────────────────────────────────────────────────
# Theralys — variables d'environnement
# Copier vers .env (racine) puis adapter. Toutes les APIs externes ont un mode
# mock : le produit fonctionne de bout en bout sans aucune clé.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de données (obligatoire) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/theralys

# ── Auth (obligatoire) ────────────────────────────────────────────────────────
# Secret de signature des sessions admin et des preview tokens (JWT).
# Générer avec : openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-random-32-byte-secret

# Compte admin créé par `pnpm db:seed`
SEED_ADMIN_EMAIL=contact@kitchenstrategy.fr
SEED_ADMIN_PASSWORD=admin-change-me

# ── IA rédaction (Anthropic) ──────────────────────────────────────────────────
# Sans clé, le pipeline tourne en mode mock (contenu français crédible,
# déterministe). AI_MOCK=1 force le mock même si une clé est présente.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_MOCK=1

# ── URLs des surfaces ─────────────────────────────────────────────────────────
# Hôte public des sites de démo (les démos sont servies sous /<slug>)
# En dev : http://localhost:3000 — en prod : https://demo.theralys-web.fr
SITES_BASE_URL=http://localhost:3000
# Port de l'admin en dev : http://localhost:3001

# ── Phase 2+ (déjà prévues, non utilisées en Phase 1) ─────────────────────────
# Google OAuth (Search Console + Business Profile) — un couple par client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clé de chiffrement au repos des refresh tokens OAuth (32 octets base64)
TOKEN_ENCRYPTION_KEY=
# Provider d'images IA (à trancher au kickoff Phase 2 : replicate | fal | mock)
IMAGE_PROVIDER=mock
REPLICATE_API_TOKEN=
FAL_API_KEY=
# Stripe (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Registrar OVH (Phase 3)
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Harmony — variables d'environnement
# Copier vers .env (racine) puis adapter. Toutes les APIs externes ont un mode
# mock : le produit fonctionne de bout en bout sans aucune clé.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de données (obligatoire) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/theralys

# ── Auth (obligatoire) ────────────────────────────────────────────────────────
# Secret de signature des sessions admin et des preview tokens (JWT).
# Générer avec : openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-random-32-byte-secret

# Comptes créés par `pnpm db:seed`
SEED_ADMIN_EMAIL=contact@kitchenstrategy.fr
SEED_ADMIN_PASSWORD=admin-change-me
SEED_CLIENT_EMAIL=claire@demo-theralys.fr
SEED_CLIENT_PASSWORD=client-demo

# ── IA rédaction (Anthropic) ──────────────────────────────────────────────────
# Clé à créer sur https://console.anthropic.com → API Keys. Dès qu'elle est
# renseignée, toute la génération (démos, articles J-7) passe par Claude —
# le mode actif est affiché dans la vue d'ensemble de l'admin.
# Sans clé, le pipeline tourne en mode mock (contenu français crédible,
# déterministe). AI_MOCK=1 force le mock même si une clé est présente
# (utile en développement pour ne rien consommer) — laisser vide en production.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_MOCK=

# ── URLs des surfaces ─────────────────────────────────────────────────────────
# Hôte public des sites de démo (les démos sont servies sous /<slug>)
# En dev : http://localhost:3000 — en prod : https://demo.harmony-web.fr
SITES_BASE_URL=http://localhost:3000
# Hôte de base supplémentaire accepté par apps/sites (optionnel) — utile pour
# garder les anciens liens *.vercel.app actifs après le passage au domaine.
DEMO_HOST=
# Ports en dev : admin http://localhost:3001 · studio http://localhost:3002
# URL publique du studio (liens d'impersonation depuis l'admin)
STUDIO_BASE_URL=http://localhost:3002

# ── IA images (décision kickoff Phase 2 : fal.ai, FLUX.1 schnell) ─────────────
# fal.ai facture ~0,003 $/mégapixel (≈ 0,0024 $/image d'article en 1024×768),
# contre 0,003 $/image fixe chez Replicate. Sans clé (ou IMAGE_PROVIDER=mock),
# illustrations SVG déterministes.
IMAGE_PROVIDER=mock
FAL_API_KEY=
# Modèles fal.ai (optionnel) : photos principales du site / images d'articles.
# Défauts : fal-ai/flux-pro/v1.1-ultra (high) et fal-ai/flux/schnell (standard).
IMAGE_MODEL_HIGH=
IMAGE_MODEL_STANDARD=

# ── Google OAuth (Search Console + fiche d'établissement, par client) ─────────
# Sans GOOGLE_CLIENT_ID, la connexion Google du studio fonctionne en mock
# (données Search Console réalistes générées localement).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clé de chiffrement au repos des refresh tokens OAuth (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
# ── Stripe Billing (abonnements par formule, webhooks, portail client) ────────
# Sans clé, la facturation tourne en mock : abonnement actif immédiatement à la
# conversion d'une démo. Les prix Stripe sont créés automatiquement par lookup
# key (theralys_<formule>_<période>) au premier usage.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Registrar OVH (achat de domaine depuis le back office client) ─────────────
# Sans clés, le registrar tourne en mock (disponibilité et prix simulés).
# Créer les clés sur https://eu.api.ovh.com/createToken/
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=

# ── Hébergement Vercel (rattachement des domaines custom au projet sites) ─────
# Sans token, le rattachement est simulé. VERCEL_SITES_PROJECT_ID = projet
# Vercel de apps/sites ; VERCEL_TEAM_ID optionnel.
VERCEL_TOKEN=
VERCEL_SITES_PROJECT_ID=
VERCEL_TEAM_ID=

# ── Jobs planifiés ─────────────────────────────────────────────────────────────
# Secret du endpoint /api/jobs/tick (admin), appelé toutes les heures par le
# cron Vercel (apps/admin/vercel.json). Générer avec : openssl rand -hex 24
CRON_SECRET=

# ── E-mails transactionnels (invitations client) ──────────────────────────────
# Sans clé, aucun e-mail ne part : l'admin copie le lien d'invitation affiché.
# Resend : gratuit jusqu'à 100 e-mails/jour — vérifier le domaine d'envoi.
RESEND_API_KEY=
MAIL_FROM=Harmony <bonjour@harmony-web.fr>

# Fiche Google (avis réels) : clé API Google Cloud avec « Places API (New) »
# activée. Sans clé, recherche et avis passent en mock (démos locales).
GOOGLE_PLACES_API_KEY=
